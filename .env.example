# Copy this file to .env and fill in the values. Never commit .env.

# Neon Postgres Database URL
DATABASE_URL=

# Email API (Brevo)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Public address of the storefront. PayRex sends buyers back here after paying.
# Local: http://localhost:3000   Production: https://your-domain.com
APP_URL=http://localhost:3000

# Admin Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=

# PayRex (https://dashboard.payrex.com > Developers)
# Secret key: API Keys tab > View secret key. Test keys start with sk_test_, live keys with sk_live_.
# Never put it in a NEXT_PUBLIC_ variable and never commit it.
PAYREX_SECRET_KEY=
# Webhook secret: shown when you create the webhook endpoint (Developers > Webhooks).
PAYREX_WEBHOOK_SECRET=

# Any long random string. Vercel Cron sends it to the daily unpaid-order cleanup.
CRON_SECRET=
