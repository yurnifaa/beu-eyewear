{
  "name": "beu-eyewear",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n store,admin -c cyan,magenta \"npm:dev:store\" \"npm:dev:admin\"",
    "dev:store": "cross-env APP_MODE=storefront next dev -p 3000",
    "dev:admin": "cross-env APP_MODE=admin next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --conditions=react-server --test lib/email/order-confirmation.test.ts",
    "postinstall": "prisma generate",
    "admin:create": "tsx --conditions=react-server prisma/create-admin.ts",
    "seed:sample-orders": "tsx --conditions=react-server prisma/seed-sample-orders.ts",
    "seed:sample-orders:clear": "tsx --conditions=react-server prisma/clear-sample-orders.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^2.8.1",
    "framer-motion": "^13.4.0",
    "lucide": "^1.43.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.2",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
